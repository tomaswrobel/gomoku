{
	"format_on_save": "on",
	"prettier": {
		"allowed": false
	},
	"formatter": [
		{
			"language_server": {
				"name": "oxfmt"
			}
		}
	],
	"languages": {
		"CSS": {
			"language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server"]
		}
	},
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"classFunctions": ["tw", "tw.map", "tw.prefixed"],
				"classAttributes": ["class"]
			}
		}
	},
	"file_types": {
		"HTML": ["html", "htm", "svg"]
	}
}
